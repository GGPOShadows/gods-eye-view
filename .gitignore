node_modules
dist
# Credential files. `.env` alone is not enough: Vite's loadEnv (see
# server/standalone/vite.config.js) and scripts/setup-doctor.mjs both read the
# full dotenv ladder — .env, .env.local, .env.<mode> and .env.<mode>.local —
# so a key placed in any of them is live for the app. Only .env was ignored,
# leaving the other three committable. .env.example is the tracked template.
.env
.env.*
!.env.example
*.log
screenshots/
qa-shots/
output/
.gev-logs/
.gev-cache/
.DS_Store
.gstack/
3d-models/
pinokio/ENVIRONMENT
pinokio/.installed

# --- secret hardening (fork-local) ---
# Upstream ignores only bare `.env`, but Vite's loadEnv and scripts/setup-doctor.mjs
# also read .env.local and .env.<mode>[.local]. Those were NOT ignored upstream.
.env
.env.*
!.env.example
pinokio/ENVIRONMENT
*.pem
*.crt
*.key
credentials.json
.gev-cache/
